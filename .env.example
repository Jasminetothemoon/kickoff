# 模型接入(OpenAI 兼容接口;任选 DeepSeek / Qwen / GLM 等)
# 不配置时系统自动使用内置 MockLLM(确定性输出,用于开发与演示)
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
MODEL_NAME=deepseek-chat

# 数据库(SQLite)
DATABASE_URL=file:./dev.db

# Web Push 主动邀约(可选):node scripts/gen-vapid.mjs 生成后填入
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
