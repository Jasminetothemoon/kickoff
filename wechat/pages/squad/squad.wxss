/* pages/squad/squad.wxss — 「小队」聊天页样式 */

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F4F4F8;
  overflow: hidden;
}

/* 消息列表 */
.chat-scroll {
  flex: 1;
  min-height: 0;
}
.msg-list {
  padding: 28rpx 28rpx 8rpx;
}
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}
.msg-row.me {
  justify-content: flex-end;
}

/* Agent 头像 */
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #EEF2FF;
  color: #4F46E5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* 气泡列 */
.bubble-wrap {
  max-width: 76%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.msg-row.me .bubble-wrap {
  align-items: flex-end;
}

/* Agent 徽章 */
.agent-badge {
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  margin-bottom: 8rpx;
}
.badge-coach { background: #EEF2FF; color: #4F46E5; }
.badge-spark { background: #FDEADD; color: #E8701A; }
.badge-pace { background: #D9F1EE; color: #0D948A; }
.badge-mirror { background: #E7E5F4; color: #1E1B4B; }
.badge-default { background: #F3F4F6; color: #4B5563; }

/* 气泡 */
.bubble {
  display: block;
  padding: 20rpx 26rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
.bubble-agent {
  background: #FFFFFF;
  color: #1F2430;
  border-top-left-radius: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 27, 75, 0.05);
}
.bubble-me {
  background: #4F46E5;
  color: #FFFFFF;
  border-top-right-radius: 6rpx;
}

/* 快捷问题 chips */
.chips {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 24rpx 16rpx;
  background: #F4F4F8;
}
.chip {
  background: #FFFFFF;
  color: #4F46E5;
  border: 1rpx solid #DDE1FB;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
  margin: 8rpx 12rpx 0 0;
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #EFEDF6;
}
.chat-input {
  flex: 1;
  background: #F4F4F8;
  border-radius: 999rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}
.send-btn {
  margin-left: 16rpx;
  flex-shrink: 0;
  width: auto;
  background: #4F46E5;
  color: #FFFFFF;
  border-radius: 999rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 36rpx;
  font-size: 28rpx;
  font-weight: 600;
}
